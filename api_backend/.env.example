PORT=3000
NODE_ENV=development
BILLING_GATE_ENABLED=false
ALLOW_HEADER_AUTH=true
PARENT_REPORT_CRON=false
PARENT_REPORT_INTERVAL_MS=86400000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (LLM + Vision + TTS)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Public web (CORS + checkout return)
PUBLIC_WEB_URL=https://quiet-mandazi-0ea7b4.netlify.app
CORS_ORIGINS=https://quiet-mandazi-0ea7b4.netlify.app
# Prod örnek: CORS_ORIGINS=https://app.rotix.example,https://www.rotix.example
CORS_ORIGINS=

# VakıfPayS — Web POS (ERTELENDİ — merchant alınca doldur)
VAKIFPAYS_API_URL=https://testpos.vakifpays.com.tr/vakifpays/api/v2
VAKIFPAYS_PAYMENT_BASE_URL=https://testpos.vakifpays.com.tr/payment
VAKIFPAYS_MERCHANT_USER=
VAKIFPAYS_MERCHANT_PASSWORD=
VAKIFPAYS_MERCHANT_CODE=
VAKIFPAYS_RETURN_URL=http://localhost:3000/api/payments/vakifpays/callback

# Parent reporting (WhatsApp / SMS) — opsiyonel
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=

# Tier quotas
TIER_BASIC_MINUTES=30
TIER_BASIC_QUESTIONS=100
TIER_PRO_MINUTES=50
TIER_PRO_QUESTIONS=300
TIER_LIMITLESS_MINUTES=-1
TIER_LIMITLESS_QUESTIONS=-1
